# Скопіюй у .env, заповни і завантаж у Cloudflare: npx wrangler secret bulk .env
# Секрети генеруй так: openssl rand -hex 32

# Токен від @BotFather
BOT_TOKEN=
# Ключ, який телефон надсилає в заголовку X-Device-Key
DEVICE_SECRET=
# Секрет webhook'а Telegram (і ключ для POST /admin/setup)
WEBHOOK_SECRET=
# Твій Telegram user ID: напиши боту /start і подивись message.from.id у getUpdates
OWNER_USER_ID=
